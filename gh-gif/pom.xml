    <artifactId>gh-gif</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gh-gif</name>
    <description>gh-gif</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.mawai</groupId>
            <artifactId>gh-common</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mawai</groupId>
            <artifactId>gh-mbPlus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
        </dependency>

<!--        <dependency>-->
