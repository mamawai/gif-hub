<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mawai.ghmbplus.dao.UserCategoryMapper">

    <select id="existsByUserIdAndCategoryName" resultType="java.lang.Boolean">
        SELECT EXISTS(
            SELECT 1 FROM user_like_category 
            WHERE user_id = #{userId} AND category_name = #{categoryName}
        )
    </select>
</mapper>
